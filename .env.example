# Copie para .env e preencha os valores. O docker compose carrega este arquivo
# automaticamente. O .env está no .gitignore — nunca faça commit dele.

# Token compartilhado exigido pelos endpoints /vision (api, vision-engine e o
# frontend usam o mesmo valor). Obrigatório, sem valor padrão.
VISION_API_SECRET_TOKEN=change-me

# PIN de 4 dígitos exigido para entrar como administrador no frontend.
# Obrigatório, sem valor padrão.
ADMIN_PIN=0000
