# Copie para .env e preencha os valores. Usado por docker-compose.frontend.yml.
# O container regenera /config.js na inicialização a partir destas variáveis.
# O .env está no .gitignore — nunca faça commit dele.

# Token compartilhado exigido pelos endpoints /vision (mesmo valor do backend).
VISION_API_SECRET_TOKEN=change-me

# PIN de 4 dígitos exigido para entrar como administrador.
ADMIN_PIN=0000
